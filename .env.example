# Local development. Set a unique secret and HTTPS settings before deployment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
TIME_ZONE=Asia/Tehran

# Leave DB_HOST and REDIS_URL empty for local SQLite / a single process.
DB_HOST=
DB_NAME=chatapp
DB_USER=chatapp
DB_PASSWORD=replace-with-a-strong-database-password
DB_PORT=5432
REDIS_URL=

# Production: enable these after configuring TLS at your trusted proxy.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
